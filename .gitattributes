* text=auto

# Source and documentation
*.cs text eol=lf diff=csharp
*.shader text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf
*.compute text eol=lf
*.json text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Unity YAML assets use UnityYAMLMerge after the Editor path is known.
*.unity text eol=lf merge=unityyamlmerge
*.prefab text eol=lf merge=unityyamlmerge
*.asset text eol=lf merge=unityyamlmerge
*.mat text eol=lf merge=unityyamlmerge
*.anim text eol=lf merge=unityyamlmerge
*.controller text eol=lf merge=unityyamlmerge
*.overrideController text eol=lf merge=unityyamlmerge
*.physicMaterial text eol=lf merge=unityyamlmerge
*.physicsMaterial2D text eol=lf merge=unityyamlmerge

# Runtime-ready PNG/OGG remain regular Git files. Editable binary sources use LFS.
*.psd filter=lfs diff=lfs merge=lfs -text
*.psb filter=lfs diff=lfs merge=lfs -text
*.kra filter=lfs diff=lfs merge=lfs -text
*.aseprite filter=lfs diff=lfs merge=lfs -text


# Preserve the approved delivery source bytes and its diagnostic delta.
/output/chapter1-playable-r1/project/** -text
/output/chapter1-boot-input-probe-20261024/project/** -text

# Keep SHA-pinned CH1 evidence and checkpoint records byte-identical.
/output/ch1-*-20261029/** -text
/output/ch1-*-20261030/** -text
/output/ch1-*-20261031/** -text
/preparation/session-integration-20261104/** -text
/docs/approvals/2026-10-24-resume-interface-limited-integration.md -text
/docs/verification/2026-10-24-resume-interface-luna-review.md -text
